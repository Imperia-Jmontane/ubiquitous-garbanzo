<div class="space-y-3 rounded-lg border border-white/10 bg-gray-950/60 p-3 text-sm text-gray-300" data-symbol-details>
    <div class="space-y-1">
        <p class="text-base font-semibold text-white" data-symbol-name>Select a symbol</p>
        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-300/80" data-symbol-kind>Type</p>
    </div>
    <dl class="space-y-2 text-xs text-gray-400">
        <div class="flex items-start justify-between gap-3">
            <dt class="text-gray-500">Full name</dt>
            <dd class="text-right text-gray-200" data-symbol-full-name>--</dd>
        </div>
        <div class="flex items-start justify-between gap-3">
            <dt class="text-gray-500">Location</dt>
            <dd class="text-right text-gray-200" data-symbol-location>--</dd>
        </div>
    </dl>
    <div class="flex flex-wrap gap-2 text-xs text-gray-400" data-symbol-modifiers>
        <span class="rounded-full border border-white/10 bg-white/5 px-2 py-1">No modifiers</span>
    </div>
    <a class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-indigo-200 transition hover:bg-white/10" href="#" data-view-in-file>
        View in file
    </a>
</div>
